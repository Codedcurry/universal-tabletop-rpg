# Copy to .env.local to change networking. Everything is optional.

# Signaling server (only used to introduce browsers to each other; game data
# goes directly between browsers). Leave unset to use the free PeerJS cloud server.
# VITE_PEER_HOST=localhost
# VITE_PEER_PORT=9000
# VITE_PEER_PATH=/peer
# VITE_PEER_SECURE=false

# STUN servers, comma-separated. Defaults to Google's free public ones.
# VITE_STUN_URLS=stun:stun.l.google.com:19302

# TURN relay for players on strict networks (some mobile carriers, offices).
# Free tiers exist (e.g. Metered, ExpressTURN); never commit real credentials.
# VITE_TURN_URL=turn:example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
